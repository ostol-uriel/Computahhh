{
  "manifest_version": 3,
  "name": "Deadline Guardian",
  "version": "1.0.0",
  "description": "Turns Canvas deadlines into active browser reminders. Shows upcoming assignments and sends alerts before they are due.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deadline Guardian"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
